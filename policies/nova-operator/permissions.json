{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ControlNovaInstance",
      "Effect": "Allow",
      "Action": ["ec2:StartInstances", "ec2:StopInstances", "ec2:RebootInstances"],
      "Resource": "arn:aws:ec2:<REGION>:<ACCOUNT_ID>:instance/<INSTANCE_ID>"
    },
    {
      "Sid": "ListBackupsPrefix",
      "Effect": "Allow",
      "Action": ["s3:ListBucket"],
      "Resource": "arn:aws:s3:::<BUCKET>",
      "Condition": { "StringLike": { "s3:prefix": ["backups/*"] } }
    },
    {
      "Sid": "ReadBackupsForRestore",
      "Effect": "Allow",
      "Action": ["s3:GetObject"],
      "Resource": "arn:aws:s3:::<BUCKET>/backups/*"
    },
    {
      "Sid": "NoResourceLevelDescribeInstances",
      "Effect": "Allow",
      "Action": ["ec2:DescribeInstances", "ec2:DescribeInstanceStatus"],
      "Resource": "*"
    },
    {
      "Sid": "NoResourceLevelReadAlarmsAndMetrics",
      "Effect": "Allow",
      "Action": ["cloudwatch:DescribeAlarms", "cloudwatch:GetMetricData"],
      "Resource": "*"
    }
  ]
}
